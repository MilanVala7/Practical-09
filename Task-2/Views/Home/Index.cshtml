@{
    ViewBag.Title = "Index";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<main class="container mt-5">

    <div class="card shadow p-4 text-center">
        <h2 class="mb-4">Text Styling Demo</h2>
        <p class="text-secondary">Please click "PRINT TEXT" button to view text when page loads.</p>

        <p id="displayText" class="fs-4"></p>

        <div class="d-flex flex-wrap justify-content-center gap-3 mt-3">

            <button class="btn btn-outline-dark" id="print" onclick="printText()">PRINT TEXT</button>

            <button class="btn btn-outline-dark" id="bold" onclick="makeBold()">BOLD</button>

            <button class="btn btn-outline-dark" id="italic" onclick="makeItalic()">ITALIC</button>

            <button class="btn btn-outline-dark" id="underline" onclick="makeUnderline()">UNDERLINE</button>

            <button class="btn btn-outline-dark" id="reset" onclick="reset()">RESET</button>

        </div>
    </div>

</main>
